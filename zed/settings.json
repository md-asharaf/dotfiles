{
  "cli_default_open_behavior": "existing_window",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "status_bar": {
    "cursor_position_button": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "debugger": {
    "button": false,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
  "git_panel": {
    "dock": "right",
  },
  "ui_font_weight": 400.0,
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
  },
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "keep_window_open",
  "redact_private_values": true,
  "use_system_prompts": true,
  "disable_ai": false,
  "file_finder": {
    "file_icons": true,
  },
  "search_wrap": true,
  "use_smartcase_search": false,
  "search": {
    "whole_word": false,
  },
  "ui_font_family": "Inter",
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "settings": {
        "github_personal_access_token": "github_personal_access_token",
      },
    },
  },
  "ssh_connections": [],
  "agent": {
    "tool_permissions": {
      "default": "allow",
    },
    "button": true,
    "dock": "left",
    "play_sound_when_agent_done": "always",
    "default_profile": "write",
    "default_model": {
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
    },
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "show_commit_summary": false,
      "enabled": true,
    },
  },
  "bottom_dock_layout": "contained",
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "max_tabs": 1,
  "tabs": {
    "activate_on_close": "history",
    "show_close_button": "always",
    "show_diagnostics": "off",
    "close_position": "right",
    "git_status": true,
    "file_icons": true,
  },
  "base_keymap": "VSCode",
  "auto_update": true,
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "toolbar": {
    "code_actions": false,
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "hide_mouse": "on_typing_and_action",
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [],
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
  },
  "icon_theme": "Catppuccin Mocha",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Zedokai Darker",
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
  },
  "buffer_font_size": 15,
  "ui_font_size": 16.0,
  "tab_size": 2,
  "hard_tabs": false,
  "auto_indent_on_paste": true,
  "buffer_font_weight": 350,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "format_on_save": "off",
  "formatter": "auto",
  "soft_wrap": "editor_width",
  "minimap": {
    "show": "always",
    "max_width_columns": 80,
  },
  "autosave": "on_focus_change",
  "terminal": {
    "blinking": "terminal_controlled",
    "cursor_shape": "bar",
    "copy_on_select": true,
    "keep_selection_on_copy": false,
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_features": {
      "ligatures": true,
    },
    "font_size": 13,
    "dock": "bottom",
    "line_height": "comfortable",
    "minimum_contrast": 45,
    "button": true,
    "shell": "system",
    "toolbar": {
      "breadcrumbs": false,
    },
    "working_directory": "current_project_directory",
    "scrollbar": {
      "show": null,
    },
  },
  "ensure_final_newline_on_save": false,
  "project_panel": {
    "hide_gitignore": false,
    "button": true,
    "default_width": 240,
    "dock": "right",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": null,
    },
    "indent_guides": {
      "show": "always",
    },
    "show_diagnostics": "errors",
    "hide_root": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "confirm_quit": false,
  "close_on_file_delete": true,
}
