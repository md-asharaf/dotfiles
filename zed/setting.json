{
    "context_servers": {
        "mcp-server-github": {
            "source": "extension",
            "enabled": true,
            "settings": {
                "github_personal_access_token": "your_github_personal_access_token_here"
            }
        }
    },
    "ssh_connections": [],
    "agent": {
        "default_profile": "write",
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-4.1"
        },
        "always_allow_tool_actions": true
    },
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": true
        }
    },
    "bottom_dock_layout": "right_aligned",
    "preview_tabs": {
        "enabled": true
    },
    "tab_bar": {
        "show": true,
        "show_tab_bar_buttons": true
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "tabs": {
        "file_icons": true
    },
    "base_keymap": "VSCode",
    "auto_update": true,
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware"
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
        "selections_menu": false
    },
    "hide_mouse": "on_typing_and_movement",
    "edit_predictions": {
        "disabled_globs": [],
        "mode": "eager",
        "copilot": {
            "proxy": null,
            "proxy_no_verify": null,
            "enterprise_uri": null
        },
        "enabled_in_text_threads": false
    },
    "icon_theme": "Material Icon Theme",
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "Zedokai Darker"
    },
    "title_bar": {
        "show_branch_icon": true
    },
    "buffer_font_size": 15,
    "ui_font_size": 16,
    "tab_size": 4,
    "hard_tabs": false,
    "auto_indent_on_paste": true,
    "buffer_font_weight": 200,
    "buffer_font_family": "JetBrainsMono Nerd Font Mono",
    "format_on_save": "on",
    "formatter": "auto",
    "soft_wrap": "editor_width",
    "minimap": {
        "show": "always",
        "max_width_columns": 50
    },
    "autosave": "on_focus_change",
    "terminal": {
        "blinking": "terminal_controlled",
        "cursor_shape": "bar",
        "copy_on_select": true,
        "keep_selection_on_copy": false,
        "font_family": "JetBrainsMono Nerd Font Mono",
        "font_features": {
            "ligatures": true
        },
        "font_size": 13,
        "dock": "bottom",
        "line_height": "comfortable",
        "minimum_contrast": 45,
        "button": true,
        "shell": "system",
        "toolbar": {
            "breadcrumbs": false
        },
        "working_directory": "current_project_directory",
        "scrollbar": {
            "show": null
        }
    },
    "project_panel": {
        "button": true,
        "default_width": 240,
        "dock": "right",
        "entry_spacing": "comfortable",
        "file_icons": true,
        "folder_icons": true,
        "git_status": true,
        "indent_size": 20,
        "auto_reveal_entries": true,
        "auto_fold_dirs": true,
        "scrollbar": {
            "show": null
        },
        "indent_guides": {
            "show": "always"
        },
        "show_diagnostics": "all",
        "hide_root": false
    },
    "scrollbar": {
        "show": "never"
    },
    "confirm_quit": false,
    "close_on_file_delete": true,
    "features": {
        "edit_prediction_provider": "zed"
    }
}
