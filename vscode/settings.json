{
    "files.autoSaveDelay": 100,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.autoRepositoryDetection": false,
    "git.openRepositoryInParentFolders": "never",
    "git.suggestSmartCommit": true,
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "security.workspace.trust.untrustedFiles": "newWindow",
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.wordWrap": "on",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "prettier.tabWidth": 4,
    "files.associations": {
        "*.css": "tailwindcss",
        ".env*": "dotenv"
    },
    "terminal.integrated.cursorStyle": "underline",
    "problems.showCurrentInStatus": true,
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": true,
        "go": true
    },
    "notebook.output.fontSize": 12,
    "terminal.integrated.fontWeight": "bold",
    "debug.console.fontSize": 12,
    "scm.inputFontSize": 14,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "workbench.editor.showTabs": "single",
    "editor.fontSize": 14,
    "editor.fontFamily": "'JetBrainsMono Nerd Font Mono','Fira Code'",
    "editor.fontLigatures": true,
    "editor.fontWeight": "400",
    "github.copilot.editor.enableAutoCompletions": true,
    "emmet.includeLanguages": {
        "django-html": "html"
    },
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "terminal.integrated.fontSize": 13,
    "explorer.confirmPasteNative": false,
    "files.autoSave": "onFocusChange",
    "extensions.ignoreRecommendations": true,
    "gitlens.advanced.messages": {
        "suppressLineUncommittedWarning": true
    },
    "explorer.compactFolders": false,
    "editor.lineNumbers": "on",
    "workbench.iconTheme": "a-file-icon-vscode",
    "window.customTitleBarVisibility": "auto",
    "editor.tokenColorCustomizations": {
        "[*Light*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#000"
                    }
                }
            ]
        },
        "[*Dark*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#fff"
                    }
                }
            ]
        },
        "textMateRules": [
            {
                "name": "envKeys",
                "scope": "string.quoted.single.ini,constant.numeric.ini,string.quoted.double.ini",
                "settings": {
                    "foreground": "#19354900"
                }
            }
        ]
    },
    "dotenv.enableAutocloaking": false,
    "editor.mouseWheelZoom": false,
    "window.zoomPerWindow": false,
    "terminal.integrated.cursorStyleInactive": "underline",
    "python.languageServer": "Pylance",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "[prisma]": {
        "editor.defaultFormatter": "Prisma.prisma"
    },
    "terminal.explorerKind": "both",
    "cursor.cpp.disabledLanguages": ["markdown", "scminput", "plaintext"],
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh"
        },
        "fish": {
            "path": "fish"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        },
        "zsh (2)": {
            "path": "/usr/bin/zsh"
        }
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "diffEditor.ignoreTrimWhitespace": true,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.ts": "default"
    },
    "breadcrumbs.enabled": false,
    "window.commandCenter": true,
    "remoteHub.commitDirectlyWarning": "off",
    "workbench.productIconTheme": "icons-carbon",
    "window.newWindowProfile": "Default",
    "workbench.colorTheme": "Monokai Pro",
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "github.copilot.selectedCompletionModel": "gpt-4o-copilot",
    "diffEditor.codeLens": true,
    "cursor.terminal.usePreviewBox": true,
    "workbench.editor.enablePreview": false,
    "geminicodeassist.inlineSuggestions.enableAuto": true,
    "[markdown]": {
        "diffEditor.ignoreTrimWhitespace": true
    },
    "workbench.experimental.share.enabled": true,
    "json.schemaDownload.enable": true,
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "workbench.startupEditor": "none",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "editor.minimap.enabled": false,
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "top",
    "github.copilot.nextEditSuggestions.enabled": true,
    "window.zoomLevel": 0.5,
    "[go]": {
        "editor.defaultFormatter": "golang.go"
    },
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-containers"
    }
}
